#!/usr/bin/env bash
# reminderctl — manage Omarchy reminders for the bralyx.reminders plugin.
#
# Reminders live as one-shot systemd user timers named
#   omarchy-reminder-<minutes>m-<unix-ts>.timer
# plus a sibling .message file in $XDG_RUNTIME_DIR/omarchy-reminders/.
# This helper owns reading that state and performing mutations so the QML
# stays a thin UI layer.
#
# Commands:
#   reminderctl list                       JSON of active reminders
#   reminderctl set <minutes>              create; message from stdin (max 500 bytes)
#   reminderctl cancel <unit>              stop + forget one reminder
#   reminderctl snooze <unit> <minutes>    re-arm a reminder N minutes from now
#   reminderctl edit <unit> <minutes>      update; message from stdin (empty keeps prior)
#   reminderctl clear                      stop + forget all reminders
set -euo pipefail

PLUGIN_ID="bralyx.reminders"
REMINDER_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-reminders"
GLYPH="󰢌"
MAX_MINUTES=999999
MAX_MESSAGE=500
SELF_UID=$(id -u)

_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

require_minutes() {
  local minutes=${1:-}
  if [[ ! $minutes =~ ^[1-9][0-9]{0,6}$ ]] || ((10#$minutes > MAX_MINUTES)); then
    echo "invalid minutes" >&2
    exit 1
  fi
}

require_unit() {
  local unit=${1:-}
  if [[ ! $unit =~ ^omarchy-reminder-[0-9]+m-[0-9]+$ ]]; then
    echo "invalid unit" >&2
    exit 1
  fi
}

require_fire_at() {
  local fire_at=${1:-}
  if [[ ! $fire_at =~ ^[0-9]{1,16}$ ]]; then
    echo "invalid fire_at" >&2
    exit 1
  fi
}

safe_headline() {
  local text=${1:-}
  if [[ $text == -* ]]; then
    printf 'Reminder: %s' "$text"
  else
    printf '%s' "$text"
  fi
}

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))
  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

# Bound stdin read so private reminder text never needs to live on argv.
read_message_stdin() {
  local raw
  raw=$(dd bs="$MAX_MESSAGE" count=1 status=none 2>/dev/null || true)
  if ((${#raw} > MAX_MESSAGE)); then
    raw="${raw:0:MAX_MESSAGE}"
  fi
  printf '%s' "$raw"
}

ensure_reminder_dir() {
  if [[ -L $REMINDER_DIR ]]; then
    echo "refusing symlink reminder dir: $REMINDER_DIR" >&2
    exit 1
  fi
  mkdir -p "$REMINDER_DIR"
  if [[ -L $REMINDER_DIR || ! -d $REMINDER_DIR ]]; then
    echo "invalid reminder dir: $REMINDER_DIR" >&2
    exit 1
  fi
  local owner mode
  owner=$(stat -c '%u' "$REMINDER_DIR")
  mode=$(stat -c '%a' "$REMINDER_DIR")
  if [[ $owner != "$SELF_UID" ]]; then
    echo "reminder dir not owned by current user" >&2
    exit 1
  fi
  if [[ $mode != 700 ]]; then
    chmod 700 "$REMINDER_DIR"
  fi
}

# Read a .message file only if it is a regular file we own, not a symlink,
# and at most MAX_MESSAGE bytes.
message_for() {
  local unit=$1
  require_unit "$unit"
  local path="$REMINDER_DIR/$unit.message"

  # no-follow: refuse symlinks; type: require regular file; owner: self only
  if [[ -L $path || ! -e $path || ! -f $path ]]; then
    return 0
  fi

  local owner size
  owner=$(stat -c '%u' "$path")
  size=$(stat -c '%s' "$path")
  if [[ $owner != "$SELF_UID" ]]; then
    return 0
  fi
  if ! [[ $size =~ ^[0-9]+$ ]]; then
    return 0
  fi

  local data
  data=$(head -c "$MAX_MESSAGE" "$path" 2>/dev/null || true)
  if [[ -L $path ]]; then
    return 0
  fi
  if ((${#data} > MAX_MESSAGE)); then
    data="${data:0:MAX_MESSAGE}"
  fi
  printf '%s' "$data"
}

write_message_file() {
  local unit=$1 message=$2
  require_unit "$unit"
  ensure_reminder_dir

  local path="$REMINDER_DIR/$unit.message"
  if [[ -L $path ]]; then
    echo "refusing symlink message path: $path" >&2
    exit 1
  fi
  if [[ -e $path && ! -f $path ]]; then
    echo "refusing non-regular message path: $path" >&2
    exit 1
  fi

  if ((${#message} > MAX_MESSAGE)); then
    message="${message:0:MAX_MESSAGE}"
  fi

  local tmp
  tmp=$(mktemp -p "$REMINDER_DIR" ".msg.XXXXXX")
  umask 077
  printf '%s' "$message" >"$tmp"
  chmod 600 "$tmp"

  if [[ -L $path ]]; then
    rm -f "$tmp"
    echo "refusing symlink message path: $path" >&2
    exit 1
  fi
  mv -f "$tmp" "$path"
}

remove_message_file() {
  local unit=$1
  require_unit "$unit"
  local path="$REMINDER_DIR/$unit.message"
  if [[ -L $path ]]; then
    return 0
  fi
  if [[ -f $path ]]; then
    local owner
    owner=$(stat -c '%u' "$path")
    [[ $owner == "$SELF_UID" ]] || return 0
    rm -f "$path"
  fi
}

_active_timers() {
  local now=${1:-$(date +%s)}
  local timer next
  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue
    next=$((next / 1000000))
    ((next <= now)) && continue
    printf "%s\t%s\n" "$timer" "$next"
  done < <(systemctl --user list-timers --all --output=json "omarchy-reminder-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')
}

parse_unit_minutes() {
  local unit=$1
  local minutes=${unit#omarchy-reminder-}
  minutes=${minutes%%m-*}
  [[ $minutes =~ ^[0-9]+$ ]] && echo "$minutes" || echo "0"
}

refresh_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
  omarchy-shell -q "${PLUGIN_ID}.widget" refresh >/dev/null 2>&1 || true
}

cmd_list() {
  local now=$(date +%s) timer next remaining unit minutes message
  local item items="[]"
  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue
    remaining=$((next - now))
    unit=${timer%.timer}
    [[ $unit =~ ^omarchy-reminder-[0-9]+m-[0-9]+$ ]] || continue
    minutes=$(parse_unit_minutes "$unit")
    message=$(message_for "$unit")
    item=$(jq -cn \
      --arg unit "$unit" \
      --arg timer "$timer" \
      --arg minutes "$minutes" \
      --arg message "$message" \
      --arg remaining "$(format_remaining "$remaining")" \
      --argjson remainingSeconds "$remaining" \
      --argjson at "$next" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" \
      '{unit:$unit,timer:$timer,minutes:$minutes,message:$message,remaining:$remaining,remainingSeconds:$remainingSeconds,at:$at,atTime:$atTime}')
    items=$(jq -cn --argjson items "$items" --argjson item "$item" '$items + [$item]')
  done < <(_active_timers "$now")
  jq -cn --argjson count "$(printf '%s' "$items" | jq 'length')" --argjson reminders "$items" '{count:$count,reminders:$reminders}'
}

stop_unit() {
  local unit=$1
  require_unit "$unit"
  systemctl --user stop "$unit.timer" 2>/dev/null || true
  remove_message_file "$unit"
}

create_unit() {
  local minutes=$1 message=$2
  require_minutes "$minutes"
  local set_at=$(date +%s)
  local unit="omarchy-reminder-${minutes}m-${set_at}"
  local fire_at=$(date -d "+${minutes} minutes" +%s)
  ensure_reminder_dir

  if [[ -n $message ]]; then
    write_message_file "$unit" "$message"
  fi

  systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="$unit" \
    "$_self" fire "$unit" "$fire_at" >/dev/null 2>&1 || true

  printf "%s\n" "$unit"
}

cmd_set() {
  local minutes=$1
  local message
  require_minutes "$minutes"
  message=$(read_message_stdin)
  create_unit "$minutes" "$message" >/dev/null
  echo "ok: reminder in ${minutes} minutes ($(date -d "+${minutes} minutes" +%-H:%M))"
  refresh_indicator
}

cmd_cancel() {
  local unit=$1
  stop_unit "$unit"
  refresh_indicator
  echo "ok: cancelled $unit"
}

cmd_snooze() {
  local unit=$1 minutes=$2
  require_unit "$unit"
  require_minutes "$minutes"
  local message
  message=$(message_for "$unit")
  stop_unit "$unit"
  create_unit "$minutes" "$message" >/dev/null
  refresh_indicator
  echo "ok: snoozed to ${minutes} minutes ($(date -d "+${minutes} minutes" +%-H:%M))"
}

cmd_edit() {
  local unit=$1 minutes=$2
  require_unit "$unit"
  require_minutes "$minutes"
  local message
  if [[ -t 0 ]]; then
    # Interactive CLI with no pipe: keep the previous message.
    message=$(message_for "$unit")
  else
    # Piped/QML stdin (including empty) replaces the message.
    message=$(read_message_stdin)
  fi
  stop_unit "$unit"
  create_unit "$minutes" "$message" >/dev/null
  refresh_indicator
  echo "ok: updated to ${minutes} minutes ($(date -d "+${minutes} minutes" +%-H:%M))"
}

cmd_clear() {
  local unit
  while IFS= read -r unit; do
    [[ -z $unit ]] && continue
    unit=${unit%.timer}
    [[ $unit =~ ^omarchy-reminder-[0-9]+m-[0-9]+$ ]] || continue
    systemctl --user stop "$unit.timer" 2>/dev/null || true
    remove_message_file "$unit"
  done < <(systemctl --user list-timers --all --no-legend --no-pager "omarchy-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1) }')
  refresh_indicator
  echo "ok: all cleared"
}

cmd_fire() {
  local unit=$1 fire_at=$2
  require_unit "$unit"
  require_fire_at "$fire_at"
  local message headline message_body
  local fired_at=$(date +%-H:%M)
  local pending=$(format_remaining $((fire_at - $(date +%s))))
  message=$(message_for "$unit")

  if [[ -n $message ]]; then
    headline=$(safe_headline "$message")
  else
    headline="Time is up"
  fi
  message_body="Due $fired_at · ${pending} ago · click to manage"

  remove_message_file "$unit"
  refresh_indicator

  omarchy-notification-send \
    -u normal -g "$GLYPH" "$headline" "$message_body" \
    --exec omarchy-shell -q shell summon "$PLUGIN_ID" '{}'
}

usage() {
  echo "Usage: reminderctl list|set|cancel|snooze|edit|clear|fire" >&2
  echo "  set/edit read the reminder message from stdin (max ${MAX_MESSAGE} bytes), never argv." >&2
  exit 1
}

case "${1:-}" in
list) cmd_list ;;
set) cmd_set "${2?missing minutes}" ;;
cancel) cmd_cancel "${2?missing unit}" ;;
snooze) cmd_snooze "${2?missing unit}" "${3?missing minutes}" ;;
edit) cmd_edit "${2?missing unit}" "${3?missing minutes}" ;;
clear) cmd_clear ;;
fire) cmd_fire "${2?missing unit}" "${3?missing fire_at}" ;;
*) usage ;;
esac
